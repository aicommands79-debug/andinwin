<Window x:Class="AndinWin.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AndinWin Kurulum Sihirbazı" Height="520" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#141820" Foreground="#E2EDF8"
        Icon="/assets/andinwin.ico">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#222B3A"/>
            <Setter Property="Foreground" Value="#E2EDF8"/>
            <Setter Property="BorderBrush" Value="#323E54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3A4E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A4EF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2230"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00C7FD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0086F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3DDC84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık Kartı -->
        <Border Grid.Row="0" Background="#1B2230" BorderBrush="#2A3549" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/assets/andinwin.png" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ubuntu-24.04 + Waydroid Otomatik Kurulum" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Adımlar: WSL kontrol ➔ Ubuntu kur ➔ systemd aktif et ➔ Waydroid paketleri ➔ GAPPS init ➔ multi-window ayarı."
                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#A0B4C8" FontSize="12"/>
                    <TextBlock Text="Not: İşlem internet hızınıza bağlı olarak 10-20 dakika sürebilir. Kurulum detayları aşağıdaki terminal alanında akacaktır."
                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#657B94" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminal Tarzı Log Kutusu -->
        <Border Grid.Row="1" Background="#0C0F15" BorderBrush="#252F40" BorderThickness="1" CornerRadius="8" Padding="4">
            <TextBox x:Name="LogBox" Background="Transparent" Foreground="#4EF28E" BorderThickness="0"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="12" TextWrapping="Wrap"
                     Padding="8" CaretBrush="#3DDC84"/>
        </Border>

        <!-- Alt Düğmeler -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="StartBtn" Content="🚀 Kurulumu Başlat" Width="165" Margin="0,0,10,0" Style="{StaticResource AccentButton}" Click="Start_Click"/>
            <Button Content="Kapat" Width="95" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
