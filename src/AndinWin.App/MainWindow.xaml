<Window x:Class="AndinWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AndinWin - Windows Android Köprüsü" Height="620" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#141820" Foreground="#E2EDF8"
        Icon="/assets/andinwin.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Fluent Koyu Buton -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#222B3A"/>
            <Setter Property="Foreground" Value="#E2EDF8"/>
            <Setter Property="BorderBrush" Value="#323E54"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3A4E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A4EF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2230"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Buton (Vurgulu Başlatma Butonu) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00C7FD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0086F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3DDC84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Koyu Menü -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#10141B"/>
            <Setter Property="Foreground" Value="#D0DBE5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#222A38"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#D0DBE5"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Modern ListView & Headers -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#171C26"/>
            <Setter Property="BorderBrush" Value="#252F40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E2EDF8"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1B222E"/>
            <Setter Property="Foreground" Value="#8EA3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#252F40"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#E2EDF8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232C3B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3353"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00A4EF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Koyu StatusBar -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="#0E1118"/>
            <Setter Property="Foreground" Value="#8697AA"/>
            <Setter Property="BorderBrush" Value="#202735"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Üst Menü -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Dosya">
                <MenuItem Header="APK Seç ve Yükle..." Click="InstallApk_Click"/>
                <Separator Background="#252F40"/>
                <MenuItem Header="Tepsiye Küçült" Click="MinimizeToTray_Click"/>
                <MenuItem Header="Çıkış" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Waydroid">
                <MenuItem Header="Yenile" Click="Refresh_Click"/>
                <MenuItem Header="Session Başlat" Click="SessionStart_Click"/>
                <MenuItem Header="Session Durdur" Click="SessionStop_Click"/>
                <Separator Background="#252F40"/>
                <MenuItem Header="WSL'i Kapat (wsl --shutdown)" Click="WslShutdown_Click"/>
            </MenuItem>
            <MenuItem Header="_Kurulum">
                <MenuItem Header="Kurulum Sihirbazı (Ubuntu + Waydroid)..." Click="SetupWizard_Click"/>
            </MenuItem>
        </Menu>

        <!-- Alt Durum Çubuğu -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Hazır. APK dosyasını pencereye sürükleyip bırakabilirsiniz." Foreground="#9FB0C4"/>
            </StatusBarItem>
            <Separator Background="#252F40"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ResourceText" Text="WSL: -" Foreground="#3DDC84" FontWeight="Medium"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Ana Gövde -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Modern Başlık Kartı (Header Banner) -->
            <Border Grid.Row="0" Background="#1B2230" BorderBrush="#2A3549" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Uygulama Logosu -->
                    <Image Grid.Column="0" Source="/assets/andinwin.png" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <!-- Başlık Metinleri -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AndinWin" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#1C2F28" BorderBrush="#256B48" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="WSL2 + Waydroid" FontSize="11" FontWeight="SemiBold" Foreground="#3DDC84"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Yüklü Android Uygulamaları (Ubuntu-24.04)" FontSize="12" Foreground="#8FA3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Hızlı Eylemler / Kısayol Bilgisi -->
                    <Border Grid.Column="2" Background="#161E2B" BorderBrush="#222F43" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="Çift tıkla başlat" FontSize="11" Foreground="#60CDFF"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Uygulama Listesi Kartı -->
            <Border Grid.Row="1" Background="#171C26" BorderBrush="#252F40" BorderThickness="1" CornerRadius="8">
                <ListView x:Name="AppList" MouseDoubleClick="AppList_DoubleClick" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Uygulama Adı" Width="280" DisplayMemberBinding="{Binding Label}"/>
                            <GridViewColumn Header="Paket Kimliği" Width="360" DisplayMemberBinding="{Binding PackageName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Alt Butonlar -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Yenile" Width="105" Margin="0,0,8,0" Click="Refresh_Click"/>
                    <Button Content="Kısayol Oluştur" Width="135" Margin="0,0,8,0" Click="Shortcut_Click"/>
                    <Button Content="APK Yükle..." Width="115" Click="InstallApk_Click"/>
                </StackPanel>

                <Button Grid.Column="2" Content="▶ Uygulamayı Başlat" Width="170" Style="{StaticResource AccentButton}" Click="Launch_Click"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
